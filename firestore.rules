rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isSuperAdmin() { return hasProfile() && myProfile().role == 'super_admin'; }
    // Vrai pour le staff (superviseur/arbitre/président/joueur) rattaché à CET événement précis.
    function isStaffOfEvent(eventId) { return hasProfile() && myProfile().eventId == eventId; }

    // --- Événements ---
    // Lecture : public si le tirage est lancé (pools != null, dashboard public), le Super-Administrateur
    // (vue système), l'organisateur qui l'a créé, ou le staff qui y est rattaché.
    // Écriture (update/delete) : Super-Administrateur, l'organisateur créateur, ou (rétrocompatibilité)
    // un événement créé avant l'ajout du champ createdBy.
    match /events/{eventId} {
      allow read: if resource.data.pools != null
        || isSuperAdmin()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid)
        || isStaffOfEvent(eventId);
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid)
        || (isSignedIn() && !('createdBy' in resource.data));
    }

    // --- Comptes utilisateurs ---
    // Un utilisateur connecté peut lire l'annuaire (nécessaire à l'admin et aux ayants droit pour
    // gérer rôles/équipes) et écrire (le filtrage fin par événement est fait côté application ;
    // voir la note ci-dessous si une isolation stricte devient nécessaire).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- Table de correspondance identifiant -> email (login par nom d'utilisateur / téléphone / ID) ---
    match /loginLookup/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isSignedIn();
    }
  }
}
